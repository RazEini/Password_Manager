# -----------------------
# Vault files & plaintext exports
# -----------------------
# Keep patterns specific: broad globs such as *password* or *vault* would also
# match this project's own source (src/password_manager/, core/vault.py).
# Git does not support trailing comments, so comments live on their own lines.

# Vaults created by `passmgr init` (the default name is vault.json)
vault.json
*vault*.json
*.vault

# Plaintext exports from `passmgr export-csv` can have any name
*.csv

# Keys and environment files
*.env
*.key
*.pem
*.crt
*.p12

__pycache__/
*.pyc
